<?php

namespace App\Http\Controllers\admin;

use App\Models\College;
use Illuminate\Http\Request;
use Illuminate\Support\FacadesDB;
use Illuminate\Support\Facades\DB;
use App\Http\Controllers\Controller;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Session;
use Illuminate\Support\Facades\Validator;

class CollegesController extends Controller
{
	
	public function index()
	{
		$data = College::get();
		return view('admin.colleges')->with('data', $data);
	}
	
	public function store(Request $request)
	{
		$data = College::select('name')->whereColumn([['name', '=', DB::raw('"'.$request->name.'"')],['name_en', '=', DB::raw('"'.$request->name_en.'"')]])->get();
		if($data->count() == 0)
		{
			$active = 0;
			if(isset($request->active) && $request->active ==1) {
				$active = 1;
			}
			$validator = Validator::make($request->all(), [
				'name' => 'required|string',
				'name_en' => 'required|string'
			]);
	
			College::create(array_merge($validator->validated(),
				['user_id' => Auth::user()->id],
				['active' => $active],
			));
			return "success";
		}
		else
		return "error";
	}
	
	public function show(College $college)
	{
		$edit_data = $college::whereColumn([['id', '=', DB::raw('"'.$college->id.'"')]])->first();
		if($edit_data != '')
		{
			$data = $college::get();
			return view('admin.colleges')->with('data', $data)->with('edit_data',$edit_data);
		}
		else
		return redirect()->route('colleges_index');
	}
	
	public function update(Request $request)
	{
		$data = College::select('name')->whereColumn([['name', '=', DB::raw('"'.$request->name.'"')],['name_en', '=', DB::raw('"'.$request->name_en.'"')],
		['active', '=', DB::raw('"'.$request->active.'"')]])->get();
		if($data->count() == 0)
		{
			$active = 0;
			if(isset($request->active) && $request->active ==1) {
				$active = 1;
			}

			$college = College::find($request->id);
			$college->name = $request->name;
			$college->name_en = $request->name_en;
			$college->active = $active;
			$college->user_id = Auth::user()->id;
			$college->save();
			return "success";
		}
		else
		return "error";
	}
	
	public function destroy(College $college)
	{
		// College::where('id', DB::raw('"'.$id.'"'))->delete();
		$college::find($college->id)->delete();
		return redirect()->route('college.index');
	}
}
